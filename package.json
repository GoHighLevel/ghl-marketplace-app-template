{
  "name": "ghl-marketplace-app-template",
  "version": "1.0.0",
  "description": "A boilerplate for creating GHL marketplace apps",
  "main": "src/index.ts",
  "scripts": {
    "build": "npx tsc",
    "vercel-build": "npm run build && cd src/ui && npm install && npm run build",
    "start": "node dist/index.js",
    "dev": "cd src/ui && npm run build && cd ../../ && ts-node-dev src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoHighLevel/ghl-marketplace-app-template.git"
  },
  "keywords": [
    "boilerplate",
    "ghl"
  ],
  "author": "GHL",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/GoHighLevel/ghl-marketplace-app-template/issues"
  },
  "homepage": "https://github.com/GoHighLevel/ghl-marketplace-app-template#readme",
  "dependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "@types/better-sqlite3": "^7.6.12",
    "axios": "^1.5.1",
    "better-sqlite3": "^11.8.1",
    "body-parser": "^1.20.2",
    "crypto-js": "^4.1.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "vue": "^3.3.4"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.1.2",
    "@types/express": "^4.17.18",
    "@types/node": "^20.8.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=20"
  }
}
